{
  "name": "no-hardcode",
  "version": "0.1.0",
  "description": "Machine-checked 'no hardcode' rules for the fleet: components use semantic design tokens only (no colour literals, no arbitrary Tailwind values, no raw font families).",
  "type": "module",
  "license": "MIT",
  "author": "Dmytro Antonyuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borntojesus/KT-NO-HARDCODE.git"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "no-hardcode": "bin/no-hardcode.js"
  },
  "exports": {
    "./eslint": "./src/eslint/index.js",
    "./stylelint": "./src/stylelint/index.js",
    "./stylelint-plugin": "./src/stylelint/plugin.js",
    "./config": "./src/shared/config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint:fixtures": "node bin/no-hardcode.js fixtures/good"
  },
  "keywords": [
    "eslint-plugin",
    "stylelint-config",
    "design-tokens",
    "tailwind",
    "hardcode"
  ],
  "dependencies": {
    "eslint": "^10.15.0",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.33",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "astro-eslint-parser": "^3.2.0",
    "eslint-plugin-astro": "^3.2.1"
  },
  "peerDependencies": {
    "astro-eslint-parser": ">=1",
    "eslint-plugin-astro": ">=1"
  },
  "peerDependenciesMeta": {
    "astro-eslint-parser": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    }
  }
}
